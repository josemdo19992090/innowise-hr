GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: enables login (email+password) and persistent storage via
# Supabase. Without these, the app runs as a single local user with no
# login, storing data in data/*.json — the original MVP behavior.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
